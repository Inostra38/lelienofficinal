# ------------------------------------
# GÉNÉRAL (OS & IDE)
# ------------------------------------
.DS_Store
.vscode/

# ------------------------------------
# PYTHON / DJANGO
# ------------------------------------
# Environnement virtuel (Crucial, car l'env dépend de l'OS)
env/
venv/
*.pyc
__pycache__/

# Base de données de développement
db.sqlite3
sqlite.db

# Fichiers de médias (uploads)
/media/  
# Remarque : On garde le dossier media/ pour la structure, mais on ignore son contenu.
# On n'envoie pas les images et PDF uploadés en prod.

# Fichiers de logs et de cache
*.log
.coverage
/htmlcov/


# ------------------------------------
# ANGULAR / NODE.JS
# ------------------------------------
# Dépendances (Très lourd, se recrée via npm install)
/node_modules
/package-lock.json 

# Dossiers de compilation et de cache
/dist/
/.angular/
.cache/
npm-debug.log

# Fichiers locaux pour la configuration Angular
# (Peuvent être ignorés s'ils ne contiennent pas de chemins d'accès critiques)
# angular.json est généralement gardé, mais le cache est ignoré.