# ------------------------------------
# GÉNÉRAL (OS & IDE)
# ------------------------------------
.DS_Store
.vscode/

# ------------------------------------
# SECRETS
# ------------------------------------
.env
*.env

# ------------------------------------
# PYTHON / DJANGO
# ------------------------------------
# Environnement virtuel
env/
venv/
.venv/
*.pyc
__pycache__/

# Base de données de développement
db.sqlite3
sqlite.db

# Dumps / backups de base (peuvent contenir des données de santé en clair — C2)
backup_*.json
*.sql
*.dump
celerybeat-schedule

# Fichiers de médias (uploads utilisateurs)
media/

# Fichiers de logs et de cache
*.log
.coverage
/htmlcov/

# Fichiers parasites
=*
.~lock.*


# ------------------------------------
# ANGULAR / NODE.JS
# ------------------------------------
# Dépendances (Très lourd, se recrée via npm install)
/node_modules

# Dossiers de compilation et de cache
/dist/
/.angular/
.cache/
npm-debug.log

# Fichiers locaux pour la configuration Angular
# (Peuvent être ignorés s'ils ne contiennent pas de chemins d'accès critiques)
# angular.json est généralement gardé, mais le cache est ignoré.